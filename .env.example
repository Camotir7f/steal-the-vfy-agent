# Steal the VFY — environment variables.
# Copy this file to `.env` and fill in the real values.
# NEVER commit `.env`. NEVER paste a secret into a chat or a model prompt.
# Secrets are loaded from the environment only.

# --- Required ---
# HMAC secret for the platform's signed envelopes. Get it from the Agent
# Games dashboard: "Rotate Secret". It is shown ONCE — copy the plaintext.
# A mismatched or placeholder secret makes preflight fail.
AGENT_GAMES_HMAC_SECRET=

# Kurier API key for submitting proofs to zkVerify (OPTIONAL audit pointer
# only — the turn response never waits on it).
# Mainnet: sign up at https://kurier.xyz
# Testnet: sign up at https://testnet.kurier.xyz
KURIER_API_KEY=

# Strategy salt — a private field element (decimal or 0x-hex). This is the
# salt your strategy commitment is built from. NEVER share it, never log
# it, never put it in a model prompt. If it leaks, your committed strategy
# can be brute-forced. Generate a fresh random 31-byte value, e.g.:
#   node -e "console.log('0x'+require('crypto').randomBytes(31).toString('hex'))"
STRATEGY_SALT=

# --- Network ---
# "testnet" uses api-testnet.kurier.xyz (no real VFY, free). "mainnet" uses
# api.kurier.xyz. Start on testnet.
KURIER_NETWORK=testnet

# --- Server ---
# Public port the service listens on. Behind a reverse proxy / TLS terminator
# in production (the platform requires a public HTTPS endpoint).
PORT=3000
# Path the platform POSTs turns to (the path you register on the dashboard).
AGENT_PATH=/agent

# --- Circuit ---
# The registered vfy-policy verification-key hash, from
# https://agentgames.zkverify.io/api/circuit-info (network: mainnet).
# The agent only attaches proofs for this circuit version.
REGISTERED_VK_HASH=0x6c56509f1c56fd1fd4e9737f906d2220f4b95f1d507f1adf6899085bd74be047
# Circuit version string sent in policyProof ("v1" -> 1 in the circuit).
CIRCUIT_VERSION=v1

# --- Behaviour ---
# Hard response deadline in ms. The platform allows 5 minutes per turn
# (it waits ~30s per push), so we fail closed well inside it.
RESPONSE_DEADLINE_MS=240000
# Max time a single Groth16 proof generation may take before the agent
# fails closed to HOLD with no proof. Local prove takes ~2s on the dev VM
# (measured 2026-11-15); the 120s budget is a generous safety margin.
PROOF_TIMEOUT_MS=120000
# Max time to wait for a Kurier job to reach Finalized before giving up on
# the on-chain pointer (the action + proof are still returned).
KURIER_FINALIZE_TIMEOUT_MS=30000
# How far in the past a turn's issuedAt may be (clock-skew guard).
TURN_MAX_AGE_MS=300000
