    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "name": "steal-the-vfy-agent",
  "scripts": {
    "build": "tsc",
    "commitment": "node scripts/commitment.mjs",
    "dev": "tsx watch src/index.ts",
    "harness": "AGENT_GAMES_HMAC_SECRET=test-secret STRATEGY_SALT=99 tsx scripts/harness.ts",
    "start": "node dist/index.js"
  },
  "type": "module",
  "version": "1.0.0"
